// Compiler-internal traits used as the runtime representation of lambda types.
// Keep this module private: source programs use lambda types such as `(A): R`.

trait Fn0[R] {
    fn call(): R;
}

trait Fn1[A0, R] {
    fn call(a0: A0): R;
}

trait Fn2[A0, A1, R] {
    fn call(a0: A0, a1: A1): R;
}

trait Fn3[A0, A1, A2, R] {
    fn call(a0: A0, a1: A1, a2: A2): R;
}

