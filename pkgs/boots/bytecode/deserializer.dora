use package::bytecode::{
    AliasData,
    ClassData,
    ClassField,
    EnumData,
    EnumVariant,
    ExtensionData,
    FunctionData,
    FunctionKind,
    GlobalData,
    ImplData,
    ModuleData,
    PackageData,
    Program,
    SourceFileData,
    StructData,
    StructField,
    TraitData,
    TypeParamBound,
    TypeParamData,
};

pub class Deserializer {
    array: Array[UInt8],
    idx: Int64,
}

impl Deserializer {
    pub static fn new(array: Array[UInt8]): Deserializer {
        Deserializer(array, idx = 0)
    }

    pub fn deserialize_program(): Program {
        unimplemented()
    }

    pub fn deserialize_package_data(): PackageData {
        unimplemented()
    }

    pub fn deserialize_module_data(): ModuleData {
        unimplemented()
    }

    pub fn deserialize_function_data(): FunctionData {
        unimplemented()
    }

    pub fn deserialize_function_kind(): FunctionKind {
        unimplemented()
    }

    pub fn deserialize_type_param_data(): TypeParamData {
        unimplemented()
    }

    pub fn deserialize_type_param_bound(): TypeParamBound {
        unimplemented()
    }

    pub fn deserialize_global_data(): GlobalData {
        unimplemented()
    }

    pub fn deserialize_class_data(): ClassData {
        unimplemented()
    }

    pub fn deserialize_class_field(): ClassField {
        unimplemented()
    }

    pub fn deserialize_struct_data(): StructData {
        unimplemented()
    }

    pub fn deserialize_struct_field(): StructField {
        unimplemented()
    }

    pub fn deserialize_enum_data(): EnumData {
        unimplemented()
    }

    pub fn deserialize_enum_variant(): EnumVariant {
        unimplemented()
    }

    pub fn deserialize_trait_data(): TraitData {
        unimplemented()
    }

    pub fn deserialize_source_file_data(): SourceFileData {
        unimplemented()
    }

    pub fn deserialize_extension_data(): ExtensionData {
        unimplemented()
    }

    pub fn deserialize_impl_data(): ImplData {
        unimplemented()
    }

    pub fn deserialize_alias_data(): AliasData {
        unimplemented()
    }
}
