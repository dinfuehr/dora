//= ok
use std::Hasher;

@Hash
struct Empty

@Hash
struct Named { value: Int32, flag: Bool }

@Hash
struct Generic[T: std::Hash](T)

fn hash[T: std::Hash](value: T): Int32 {
    let hasher = std::DefaultHasher::new();
    value.hash[std::DefaultHasher](hasher);
    hasher.finish()
}

fn use_hash(value: Named): Int32 {
    hash[Named](value)
}
