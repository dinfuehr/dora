//= ok
@Comparable
class Empty

@Comparable
class Named { value: Int32, other: String }

@Comparable
class Generic[T: std::Comparable](T)

fn compare[T: std::Comparable](lhs: T, rhs: T): std::Ordering {
    lhs.cmp(rhs)
}

fn use_compare(lhs: Named, rhs: Named): std::Ordering {
    compare[Named](lhs, rhs)
}
