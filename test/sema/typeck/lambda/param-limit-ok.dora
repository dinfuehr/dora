//= ok

fn accept(
    _regular: (
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
    ): Int32,
    _variadic: (
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32,
        Int32...,
    ): Int64,
) {}

fn main() {
    accept(
        |
            _a0,
            _a1,
            _a2,
            _a3,
            _a4,
            _a5,
            _a6,
            _a7,
            _a8,
            _a9,
            _a10,
            _a11,
            _a12,
            _a13,
            _a14,
            _a15,
        |: Int32 { _a0 + _a15 },
        |
            _a0,
            _a1,
            _a2,
            _a3,
            _a4,
            _a5,
            _a6,
            _a7,
            _a8,
            _a9,
            _a10,
            _a11,
            _a12,
            _a13,
            _a14,
            values...,
        |: Int64 { values.size() },
    );
}
