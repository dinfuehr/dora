//= ok

struct Pair {
    value: Int32,
}

class ArrayHolder {
    values: Array[Int32],
}

fn element(array: Array[Int32], index: Int64): ref Int32 {
    ref array(index)
}

fn genericElement[T](array: Array[T], index: Int64): ref T {
    ref array(index)
}

fn elementField(array: Array[Pair], index: Int64): ref Int32 {
    ref array(index).value
}

fn elementTupleField(array: Array[(Int32, Bool)], index: Int64): ref Int32 {
    ref array(index).0
}

fn objectFieldElement(holder: ArrayHolder, index: Int64): ref Int32 {
    ref holder.values(index)
}

fn assignObjectFieldElement(holder: ArrayHolder, index: Int64, value: Int32) {
    holder.values(index) = value;
}
