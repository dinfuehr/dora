//= ok

let mut value: Int32 = 0i32;
let mut static_value: Int32 = 0i32;

class Factory

impl Factory {
    static fn value_ref(): ref mut Int32 {
        ref mut static_value
    }
}

mod foo {
    pub mod bar {
        pub let mut value: Int32 = 0i32;

        pub fn baz(): ref mut Int32 {
            ref mut value
        }
    }
}

fn value_ref(): ref mut Int32 {
    ref mut value
}

fn assign() {
    value_ref() = 10i32;
    foo::bar::baz() = 20i32;
    Factory::value_ref() = 30i32;

    let get_ref = ||: ref mut Int32 { ref mut value };
    get_ref() = 40i32;
}
