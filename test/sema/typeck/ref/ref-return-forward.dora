//= ok

class Holder { value: Int32 }

fn field_ref(holder: Holder): ref Int32 {
    ref holder.value
}

fn forward(holder: Holder): ref Int32 {
    ref field_ref(holder)
}

fn explicit_forward(holder: Holder): ref Int32 {
    return ref field_ref(holder);
}

trait Value {
    fn value(): ref Int32;
}

fn forward_method(value: Value): ref Int32 {
    ref value.value()
}

class GenericHolder[T] { value: T }

fn generic_field_ref[T](holder: GenericHolder[T]): ref T {
    ref holder.value
}

fn no_holder[T](): GenericHolder[T] {
    std::unreachable[GenericHolder[T]]()
}

fn inferred_forward(): ref Int32 {
    ref generic_field_ref(no_holder())
}
