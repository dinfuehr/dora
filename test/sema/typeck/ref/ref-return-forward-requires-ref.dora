class Holder { value: Int32 }

fn field_ref(holder: Holder): ref Int32 {
    ref holder.value
}

fn value(): Int32 {
    1i32
}

fn bare_forward(holder: Holder): ref Int32 {
    field_ref(holder)
}

fn bare_explicit_forward(holder: Holder): ref Int32 {
    return field_ref(holder);
}

trait Value {
    fn value(): ref Int32;
}

fn bare_forward_method(value: Value): ref Int32 {
    value.value()
}

fn ref_value_call(): ref Int32 {
    ref value()
}
