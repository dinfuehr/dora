let mut returned_value: Int32 = 1i32;

fn identity(_value: ref Int32): ref Int32 {
    ref returned_value
}

fn consume(_value: Int32) {}

fn return_value(): Int32 {
    identity(ref returned_value)
}

class Identity

impl Identity {
    fn identity(_value: ref Int32): ref Int32 {
        ref returned_value
    }
}

fn test() {
    let value = 1i32;
    let value_copy = identity(ref value);
    let value_ref = ref identity(ref value);
    let method_value_copy = Identity().identity(ref value);
    let method_value_ref = ref Identity().identity(ref value);
    let parenthesized_ref = ref (identity(ref value));
    let identity_lambda = |_value: ref Int32|: ref Int32 { ref returned_value };
    let lambda_value_copy = identity_lambda(ref value);
    let lambda_value_ref = ref identity_lambda(ref value);
    consume(identity(ref value));
    consume(Identity().identity(ref value));
    consume(return_value());
}
