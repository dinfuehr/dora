@Equals
enum Payload {
    Empty,
    Integer(Int32),
    Pair(Int32, Bool),
}

@Equals
enum Color { Red, Green, Blue }

fn equals[T: std::Equals](lhs: T, rhs: T): Bool {
    lhs == rhs
}

fn direct(lhs: Color, rhs: Color): Bool {
    lhs == rhs
}

fn payload(lhs: Payload, rhs: Payload): Bool {
    lhs == rhs
}
