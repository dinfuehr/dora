struct A { b: B }
struct B { c: C }
struct C { d: Int32 }
struct X { a: A }
fn f(x: X): Int32 { x.a.b.c.d }
fn load_single(x: X): A { x.a }
fn identity(x: X): X { x }
fn load_temporary(x: X): Int32 { identity(x).a.b.c.d }
fn load_captured(x: X): (): Int32 { ||: Int32 { x.a.b.c.d } }
fn load_context_local(x: X): Int32 { let lambda = ||: X { x }; x.a.b.c.d }
