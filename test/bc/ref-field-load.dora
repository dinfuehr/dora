struct Inner { value: Int32 }
class Box { inner: Inner }
struct Outer { box: Box }

fn read(value: ref Outer): Int32 {
    value.box.inner.value
}

fn read_class(value: ref Box): Int32 {
    value.inner.value
}

fn read_box(value: Box): Int32 {
    value.inner.value
}

fn read_tuple(value: ref (Int32, Int64)): Int64 {
    value.1
}

fn read_ref_expr(value: Inner): Int32 {
    (ref value).value
}
