@Hash
class ClassValue { number: Int32, flag: Bool }

@Hash
struct StructValue(Int32, Bool)

fn class_hash(value: ClassValue): Int32 {
    let hasher = std::Hasher::new();
    value.hash(hasher);
    hasher.finish()
}

fn struct_hash(value: StructValue): Int32 {
    let hasher = std::Hasher::new();
    value.hash(hasher);
    hasher.finish()
}
