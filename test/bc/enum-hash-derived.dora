@Hash
enum Payload {
    Empty,
    Integer(Int32),
    Pair(Int32, Bool),
}

@Hash
enum Color { Red, Green, Blue }

fn hash[T: std::Hash](value: T): Int32 {
    let hasher = std::Hasher::new();
    value.hash(hasher);
    hasher.finish()
}

fn direct(value: Color): Int32 {
    let hasher = std::Hasher::new();
    value.hash(hasher);
    hasher.finish()
}

fn payload(value: Payload): Int32 {
    let hasher = std::Hasher::new();
    value.hash(hasher);
    hasher.finish()
}
