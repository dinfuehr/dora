fn and_lhs(): Bool {
    std::abort() && true
}

fn and_rhs(value: Bool): Bool {
    value && std::abort()
}

fn or_lhs(): Bool {
    std::abort() || false
}

fn or_rhs(value: Bool): Bool {
    value || std::abort()
}

fn main() {
    if and_rhs(false) {
        std::exit(1i32);
    }

    if !or_rhs(true) {
        std::exit(1i32);
    }
}
