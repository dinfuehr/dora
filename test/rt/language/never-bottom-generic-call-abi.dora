//= error code 1

let mut value: Int32 = 7i32;

fn fail[T](code: Int32): T {
    if code == 42i32 {
        std::exit(1i32)
    } else {
        fail[T](code)
    }
}

fn choose(take_value: Bool): ref Int32 {
    if take_value {
        ref value
    } else {
        fail[std::Never](42i32)
    }
}

fn main() {
    choose(false);
}
