//= runtime-args "--gc-verify"

class Holder {
    value: Int32,
}

fn main() {
    let get_value = |holder: Holder|: ref mut Int32 {
        ref mut holder.value
    };
    let value = ref mut get_value(Holder(17i32));

    std::force_minor_collect();
    assert(value == 17i32);

    value = 23i32;
    std::force_collect();
    assert(value == 23i32);
}
