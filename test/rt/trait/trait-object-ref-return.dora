//= runtime-args "--gc-verify"

trait Value {
    fn value(): ref mut Int32;
}

class Holder {
    value: Int32,
}

impl Value for Holder {
    fn value(): ref mut Int32 {
        ref mut self.value
    }
}

@NeverInline
fn get_value(object: Value): ref mut Int32 {
    ref mut object.value()
}

fn main() {
    let value = ref mut get_value(Holder(17i32) as Value);

    std::force_minor_collect();
    assert(value == 17i32);

    value = 23i32;
    std::force_collect();
    assert(value == 23i32);
}
