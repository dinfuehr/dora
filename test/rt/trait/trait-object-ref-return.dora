//= runtime-args "--gc-verify"

trait Value {
    fn value(): ref Int32;
}

class Holder {
    value: Int32,
}

impl Value for Holder {
    fn value(): ref Int32 {
        ref self.value
    }
}

fn main() {
    let object = Holder(17i32) as Value;
    let value = object.value();

    std::force_minor_collect();
    assert(value == 17i32);

    value = 23i32;
    std::force_collect();
    assert(value == 23i32);
}
