use std::Hasher;

fn main() {
    assert(hash(EmptyClass()) == 0);
    assert(hash(ClassValue(7, true)) == 6);
    assert(hash(ClassValue(7, true)) == hash(ClassValue(7, true)));
    assert(hash(GenericClass[Int32](7)) == 7);

    assert(hash(EmptyStruct()) == 0);
    assert(hash(StructValue(7, true)) == 6);
    assert(hash(StructValue(7, true)) == hash(StructValue(7, true)));
    assert(hash(GenericStruct[Int32](7)) == 7);

    assert(hash(Color::Red) == 0);
    assert(hash(Color::Green) == 1);
    assert(hash(Color::Blue) == 2);
    assert(hash[Color](Color::Green) == 1);

    assert(hash(Payload::Empty) == 0);
    assert(hash(Payload::Integer(7)) == 6);
    assert(hash(Payload::Flag(true)) == 3);
    assert(hash(Payload::Pair(7, true)) == 5);

    assert(hash(Generic[Int32]::None) == 0);
    assert(hash(Generic[Int32]::Some(7)) == 6);

    assert(sum_hash(ClassValue(7, true)) == 8);
    assert(sum_hash(Payload::Pair(7, true)) == 11);
}

@Hash
class EmptyClass

@Hash
class ClassValue(Int32, Bool)

@Hash
class GenericClass[T: std::Hash](T)

@Hash
struct EmptyStruct

@Hash
struct StructValue(Int32, Bool)

@Hash
struct GenericStruct[T: std::Hash](T)

@Hash
enum Color {
    Red,
    Green,
    Blue,
}

@Hash
enum Payload {
    Empty,
    Integer(Int32),
    Flag(Bool),
    Pair(Int32, Bool),
}

@Hash
enum Generic[T: std::Hash] {
    None,
    Some(T),
}

fn hash[T: std::Hash](value: T): Int32 {
    let hasher = std::DefaultHasher::new();
    value.hash[std::DefaultHasher](hasher);
    hasher.finish()
}

class SumHasher {
    value: Int32,
}

impl SumHasher {
    static fn new(): SumHasher {
        SumHasher(value = 0i32)
    }
}

impl std::Hasher for SumHasher {
    fn write_int32(value: Int32) {
        self.value = self.value + value;
    }

    fn write_int64(value: Int64) {
        self.value = self.value + value.hash();
    }

    fn finish(): Int32 {
        self.value
    }
}

fn sum_hash[T: std::Hash](value: T): Int32 {
    let hasher = SumHasher::new();
    value.hash[SumHasher](hasher);
    hasher.finish()
}
