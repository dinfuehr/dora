class Box { value: Int32 }

fn update(value: ref mut Int32, replacement: Int32) {
    value = replacement;
}

fn main() {
    let mut stack_value = 10i32;
    update(ref mut stack_value, 11i32);
    assert(stack_value == 11i32);

    let stack_value_ref: ref mut Int32 = ref mut stack_value;
    update(ref mut stack_value_ref, 12i32);
    assert(stack_value == 12i32);

    let box = Box(20i32);
    update(ref mut box.value, 21i32);
    assert(box.value == 21i32);
}
