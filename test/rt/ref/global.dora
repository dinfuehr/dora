class Box {
    value: Int32,
}

struct Pair {
    first: Int32,
    second: Int64,
}

let mut int_value: Int32 = 10i32;
let mut class_value: Box = Box(20i32);
let mut struct_value: Pair = Pair(first = 30i32, second = 31i64);
let mut initialization_count: Int32 = 0i32;
let mut lazy_value: Int32 = initialize_lazy_value();

fn initialize_lazy_value(): Int32 {
    initialization_count += 1i32;
    40i32
}

fn replace_int(value: ref mut Int32, replacement: Int32): Int32 {
    let previous = value;
    value = replacement;
    previous
}

fn replace_class(value: ref mut Box, replacement: Box): Box {
    let previous = value;
    value = replacement;
    previous
}

fn replace_struct(value: ref mut Pair, replacement: Pair): Pair {
    let previous = value;
    value = replacement;
    previous
}

@NeverInline
fn int_ref(): ref mut Int32 {
    ref mut int_value
}

@NeverInline
fn class_ref(): ref mut Box {
    ref mut class_value
}

@NeverInline
fn struct_ref(): ref mut Pair {
    ref mut struct_value
}

@NeverInline
fn lazy_ref(): ref Int32 {
    ref lazy_value
}

fn main() {
    assert(initialization_count == 0i32);
    let returned_lazy_ref = lazy_ref();
    assert(initialization_count == 1i32);
    assert(returned_lazy_ref == 40i32);

    assert(replace_int(ref mut int_value, 11i32) == 10i32);
    assert(int_value == 11i32);

    let previous_class = replace_class(ref mut class_value, Box(21i32));
    assert(previous_class.value == 20i32);
    std::force_collect();
    assert(class_value.value == 21i32);

    let previous_struct = replace_struct(
        ref mut struct_value,
        Pair(first = 32i32, second = 33i64),
    );
    assert(previous_struct.first == 30i32);
    assert(previous_struct.second == 31i64);
    assert(struct_value.first == 32i32);
    assert(struct_value.second == 33i64);

    let returned_int_ref = int_ref();
    returned_int_ref = 12i32;
    assert(int_value == 12i32);

    let returned_class_ref = class_ref();
    std::force_collect();
    returned_class_ref = Box(22i32);
    assert(class_value.value == 22i32);

    let returned_struct_ref = struct_ref();
    std::force_collect();
    returned_struct_ref = Pair(first = 34i32, second = 35i64);
    assert(struct_value.first == 34i32);
    assert(struct_value.second == 35i64);
}
