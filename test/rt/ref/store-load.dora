class Foo {
    value: Int32,
}

class Bar {
    foo: Foo,
}

fn replace_and_read(bar: Bar, field: ref Foo, replacement: Foo): Int32 {
    let old_value = bar.foo.value;
    field = replacement;
    old_value * 10i32 + bar.foo.value
}

fn main() {
    let bar = Bar(Foo(1i32));
    let result = replace_and_read(bar, ref bar.foo, Foo(2i32));

    assert(result == 12i32);
    assert(bar.foo.value == 2i32);
}
