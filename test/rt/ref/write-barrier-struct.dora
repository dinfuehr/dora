//= compile-args "--gc=swiper"
//= runtime-args "--gc-verify"

class Foo {
    value: Int32,
}

struct OneRef {
    marker: Int32,
    value: Foo,
}

struct TwoRefs {
    first: Foo,
    second: Foo,
}

class OneRefHolder {
    value: OneRef,
}

class TwoRefsHolder {
    value: TwoRefs,
}

fn replace_one(value: ref mut OneRef, replacement: OneRef) {
    value = replacement;
}

fn replace_two(value: ref mut TwoRefs, replacement: TwoRefs) {
    value = replacement;
}

fn test_one_ref() {
    let holder = OneRefHolder(OneRef(marker = 1i32, value = Foo(2i32)));
    std::force_collect();

    replace_one(ref mut holder.value, OneRef(marker = 3i32, value = Foo(4i32)));

    std::force_minor_collect();
    assert(holder.value.marker == 3i32);
    assert(holder.value.value.value == 4i32);
}

fn test_two_refs() {
    let holder = TwoRefsHolder(TwoRefs(first = Foo(5i32), second = Foo(6i32)));
    std::force_collect();

    replace_two(ref mut holder.value, TwoRefs(first = Foo(7i32), second = Foo(8i32)));

    std::force_minor_collect();
    assert(holder.value.first.value == 7i32);
    assert(holder.value.second.value == 8i32);
}

fn main() {
    test_one_ref();
    test_two_refs();
}
