//= compile-args "--gc=swiper"
//= runtime-args "--gc-verify"

class Foo {
    value: Int32,
}

class OneRefHolder {
    value: (Int32, Foo),
}

class TwoRefsHolder {
    value: (Foo, Foo),
}

fn replace_one(value: ref (Int32, Foo), replacement: (Int32, Foo)) {
    value = replacement;
}

fn replace_two(value: ref (Foo, Foo), replacement: (Foo, Foo)) {
    value = replacement;
}

fn test_one_ref() {
    let holder = OneRefHolder((1i32, Foo(2i32)));
    std::force_collect();

    replace_one(ref holder.value, (3i32, Foo(4i32)));

    std::force_minor_collect();
    assert(holder.value.0 == 3i32);
    assert(holder.value.1.value == 4i32);
}

fn test_two_refs() {
    let holder = TwoRefsHolder((Foo(5i32), Foo(6i32)));
    std::force_collect();

    replace_two(ref holder.value, (Foo(7i32), Foo(8i32)));

    std::force_minor_collect();
    assert(holder.value.0.value == 7i32);
    assert(holder.value.1.value == 8i32);
}

fn main() {
    test_one_ref();
    test_two_refs();
}
