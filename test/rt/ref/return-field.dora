//= runtime-args "--gc-verify"

class Box { value: Int32 }

@NeverInline
fn make_ref(value: Int32): ref mut Int32 {
    let obj = Box(value);
    ref mut obj.value
}

@NeverInline
fn forward_ref(value: Int32): ref mut Int32 {
    ref mut make_ref(value)
}

fn main() {
    let value = ref mut forward_ref(17i32);

    std::force_minor_collect();
    assert(value == 17i32);

    value = 23i32;
    std::force_collect();
    assert(value == 23i32);
}
