//= compile-args "--gc=swiper"
//= runtime-args "--gc-verify"

struct Pair {
    value: Int32,
}

struct Nested {
    pair: Pair,
}

class Holder {
    pairs: Array[Pair],
    nested: Array[Nested],
    tuples: Array[(Int32, Bool)],
}

@NeverInline
fn element_field_ref(holder: Holder, index: Int64): ref mut Int32 {
    ref mut holder.pairs(index).value
}

@NeverInline
fn nested_element_field_ref(holder: Holder, index: Int64): ref mut Int32 {
    ref mut holder.nested(index).pair.value
}

@NeverInline
fn element_tuple_field_ref(holder: Holder, index: Int64): ref mut Int32 {
    ref mut holder.tuples(index).0
}

@NeverInline
fn new_holder_element_field_ref(): ref mut Int32 {
    let holder = Holder(
        pairs = Array[Pair]::new(Pair(value = 10i32)),
        nested = Array[Nested]::new(Nested(pair = Pair(value = 20i32))),
        tuples = Array[(Int32, Bool)]::new((30i32, true)),
    );
    ref mut holder.pairs(0i64).value
}

fn main() {
    let holder = Holder(
        pairs = Array[Pair]::new(Pair(value = 1i32), Pair(value = 2i32)),
        nested = Array[Nested]::new(Nested(pair = Pair(value = 3i32))),
        tuples = Array[(Int32, Bool)]::new((4i32, true)),
    );

    let _local_ref = ref mut holder.pairs(0i64).value;
    _local_ref = 5i32;
    assert(holder.pairs(0i64).value == 5i32);

    let field_ref = ref mut element_field_ref(holder, 1i64);
    std::force_collect();
    assert(field_ref == 2i32);
    field_ref = 6i32;
    assert(holder.pairs(1i64).value == 6i32);

    let nested_ref = ref mut nested_element_field_ref(holder, 0i64);
    std::force_collect();
    assert(nested_ref == 3i32);
    nested_ref = 7i32;
    assert(holder.nested(0i64).pair.value == 7i32);

    let tuple_ref = ref mut element_tuple_field_ref(holder, 0i64);
    std::force_collect();
    assert(tuple_ref == 4i32);
    tuple_ref = 8i32;
    assert(holder.tuples(0i64).0 == 8i32);

    let new_holder_ref = ref mut new_holder_element_field_ref();
    std::force_collect();
    assert(new_holder_ref == 10i32);
    new_holder_ref = 9i32;
    assert(new_holder_ref == 9i32);
}
