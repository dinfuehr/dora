fn replace_bool(value: ref mut Bool, replacement: Bool): Bool {
    let previous = value;
    value = replacement;
    previous
}

fn replace_uint8(value: ref mut UInt8, replacement: UInt8): UInt8 {
    let previous = value;
    value = replacement;
    previous
}

fn replace_char(value: ref mut Char, replacement: Char): Char {
    let previous = value;
    value = replacement;
    previous
}

fn replace_int32(value: ref mut Int32, replacement: Int32): Int32 {
    let previous = value;
    value = replacement;
    previous
}

fn replace_int64(value: ref mut Int64, replacement: Int64): Int64 {
    let previous = value;
    value = replacement;
    previous
}

fn replace_float32(value: ref mut Float32, replacement: Float32): Float32 {
    let previous = value;
    value = replacement;
    previous
}

fn replace_float64(value: ref mut Float64, replacement: Float64): Float64 {
    let previous = value;
    value = replacement;
    previous
}

fn main() {
    let mut bool_value = true;
    assert(replace_bool(ref mut bool_value, false));
    assert(!bool_value);

    let mut uint8_value = 10u8;
    assert(replace_uint8(ref mut uint8_value, 11u8) == 10u8);
    assert(uint8_value == 11u8);

    let mut char_value = 'a';
    assert(replace_char(ref mut char_value, 'b') == 'a');
    assert(char_value == 'b');

    let mut int32_value = 10i32;
    assert(replace_int32(ref mut int32_value, 11i32) == 10i32);
    assert(int32_value == 11i32);

    let mut int64_value = 10i64;
    assert(replace_int64(ref mut int64_value, 11i64) == 10i64);
    assert(int64_value == 11i64);

    let mut float32_value = 10.5f32;
    assert(replace_float32(ref mut float32_value, 11.5f32) == 10.5f32);
    assert(float32_value == 11.5f32);

    let mut float64_value = 10.5;
    assert(replace_float64(ref mut float64_value, 11.5) == 10.5);
    assert(float64_value == 11.5);
}
