impl (Int32, Int32) {
    mutating fn move_by(dx: Int32, dy: Int32) {
        self.0 = self.0 + dx;
        self.1 = self.1 + dy;
    }
}

fn main() {
    let mut point = (1i32, 2i32);
    point.move_by(10i32, 20i32);
    assert(point.0 == 11i32);
    assert(point.1 == 22i32);

    point.move_by(-5i32, -10i32);
    assert(point.0 == 6i32);
    assert(point.1 == 12i32);
}
